+// formatEnvelopeHeader summarizes the scalar (non-slice, non-struct) fields of
+// an envelope on a single line. Returns "" if there are no scalars to show.
+func formatEnvelopeHeader(v reflect.Value, sliceFields []structSliceField) string {
+	skip := make(map[int]struct{}, len(sliceFields))
+	for _, sf := range sliceFields {
+		skip[sf.index] = struct{}{}
+	}
+
+	t := v.Type()
+	var parts []string
+	for i := 0; i < t.NumField(); i++ {
+		if _, ok := skip[i]; ok {
+			continue
+		}
+		f := t.Field(i)
+		if !f.IsExported() {
+			continue
+		}
+		ft := f.Type
+		for ft.Kind() == reflect.Ptr {
+			ft = ft.Elem()
+		}
+		switch ft.Kind() {
+		case reflect.Map:
+			if !isOptionalNullableType(ft) {
+				continue
+			}
+		case reflect.Struct, reflect.Slice, reflect.Array, reflect.Func, reflect.Chan:
+			continue
+		}
+		cell := formatTableCell(v.Field(i))
+		if cell == "" {
+			continue
+		}
+		parts = append(parts, fmt.Sprintf("%s=%s", strings.ToUpper(fieldDisplayName(f)), cell))
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return strings.Join(parts, "  ")
+}
