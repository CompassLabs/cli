+// isOptionalNullableType reports whether t matches the
+// optionalnullable.OptionalNullable[T] shape (map[bool]*T). We match on shape
+// rather than importing the package to avoid a cycle and to stay tolerant if
+// the package moves.
+func isOptionalNullableType(t reflect.Type) bool {
+	return t.Kind() == reflect.Map &&
+		t.Key().Kind() == reflect.Bool &&
+		t.Elem().Kind() == reflect.Ptr
+}
+
+// unwrapOptionalNullable returns (underlying value, true) when v holds an
+// OptionalNullable[T] set to a non-nil value. Otherwise returns (zero, false).
+func unwrapOptionalNullable(v reflect.Value) (reflect.Value, bool) {
+	if !isOptionalNullableType(v.Type()) {
+		return reflect.Value{}, false
+	}
+	inner := v.MapIndex(reflect.ValueOf(true))
+	if !inner.IsValid() || inner.IsNil() {
+		return reflect.Value{}, false
+	}
+	return inner.Elem(), true
+}
