+// printTableUnwrapped renders an envelope or multi-list response. Scalar
+// metadata is shown once at the top; each slice-of-struct field is rendered
+// as its own table, with a section header for multi-list responses.
+func printTableUnwrapped(out io.Writer, v reflect.Value, sliceFields []structSliceField) error {
+	if header := formatEnvelopeHeader(v, sliceFields); header != "" {
+		fmt.Fprintln(out, header)
+	}
+
+	showSectionHeader := len(sliceFields) > 1
+	for _, sf := range sliceFields {
+		if showSectionHeader {
+			fmt.Fprintf(out, "\n%s:\n", strings.ToUpper(sf.name))
+		}
+		if err := printTableRows(out, v.Field(sf.index)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
