+// shouldRenderAsTable reports whether content is a list-shaped response —
+// either a slice of structs (e.g. []Position) or a struct envelope that
+// contains one or more slice-of-struct fields (e.g. {total, offset, vaults[]}
+// or {aave[], vaults[], pendle_pt[]}). These are the shapes where a table
+// view is dramatically more readable than verbose key:value output.
+//
+// The slice branch checks the element TYPE, not the first value, so empty
+// slice-of-struct responses still take the table path and render as "(empty)"
+// — consistent with how the envelope path handles empty inner slices.
+func shouldRenderAsTable(content any) bool {
+	if content == nil {
+		return false
+	}
+	v := reflect.ValueOf(content)
+	for v.Kind() == reflect.Ptr || v.Kind() == reflect.Interface {
+		if v.IsNil() {
+			return false
+		}
+		v = v.Elem()
+	}
+	switch v.Kind() {
+	case reflect.Slice, reflect.Array:
+		elemType := v.Type().Elem()
+		for elemType.Kind() == reflect.Ptr {
+			elemType = elemType.Elem()
+		}
+		return elemType.Kind() == reflect.Struct
+	case reflect.Struct:
+		return len(structOfStructSliceFields(v)) > 0
+	}
+	return false
+}
+
+// structSliceField identifies a slice-of-struct field on a parent struct.
+type structSliceField struct {
+	name  string // json tag if present, else the Go field name
+	index int    // index into the parent struct
+}
+
+// structOfStructSliceFields returns the slice-of-struct fields of v in
+// declaration order. These are the fields a table view should unwrap when
+// rendering an envelope or multi-list response.
+func structOfStructSliceFields(v reflect.Value) []structSliceField {
+	t := v.Type()
+	var out []structSliceField
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if !f.IsExported() {
+			continue
+		}
+		ft := f.Type
+		for ft.Kind() == reflect.Ptr {
+			ft = ft.Elem()
+		}
+		if ft.Kind() != reflect.Slice && ft.Kind() != reflect.Array {
+			continue
+		}
+		elem := ft.Elem()
+		for elem.Kind() == reflect.Ptr {
+			elem = elem.Elem()
+		}
+		if elem.Kind() != reflect.Struct {
+			continue
+		}
+		out = append(out, structSliceField{name: fieldDisplayName(f), index: i})
+	}
+	return out
+}
+
+// fieldDisplayName returns the JSON tag name when set, else the Go field name.
+func fieldDisplayName(f reflect.StructField) string {
+	if tag := f.Tag.Get("json"); tag != "" {
+		if name := strings.Split(tag, ",")[0]; name != "" && name != "-" {
+			return name
+		}
+	}
+	return f.Name
+}
